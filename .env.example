NAS_MODEL_PROVIDER=opencode

# OpenCode Go (generación)
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_BASE_URL=https://opencode.ai/inference/go
OPENCODE_API=auto
OPENCODE_FALLBACK_MODELS=
OPENCODE_TIMEOUT=120
OPENCODE_MAX_RETRIES=2

# OpenRouter (generación y decisión)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=NAS ADK
OPENROUTER_FALLBACK_MODELS=

# TypeSafe Jev (decisión)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT=5
JEV_MAX_RETRIES=2

# Anthropic API (facturación por API; requiere: pip install 'nas-adk[anthropic]')
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=2

# Claude Code local (suscripción; uso personal; autentícate tú con `claude auth login`)
# Con ANTHROPIC_API_KEY definida el proveedor claude-code se niega a arrancar (reject)
# salvo CLAUDE_CODE_ENV_POLICY=scrub.
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT=300
CLAUDE_CODE_MAX_CONCURRENCY=1
CLAUDE_CODE_ENV_POLICY=reject
